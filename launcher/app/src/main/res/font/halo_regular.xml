<?xml version="1.0" encoding="utf-8"?>
<!-- Halo Sans (Mona Sans, subset and renamed under the OFL) at weight 400, built once per process.
     android:fontVariationSettings on each TextView rebuilt the variable font for every view (about 10 ms each
     on a TV CPU). Android 8 ignores the weight here and draws the default instance. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/halo_sans"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400"
        tools:targetApi="28" />
</font-family>
