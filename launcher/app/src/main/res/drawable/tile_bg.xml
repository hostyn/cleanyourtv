<?xml version="1.0" encoding="utf-8"?>
<!-- The surface of a tile without a banner (an input tile, or an app with only an icon): graphite with a soft
     diagonal fall-off and a 1dp highlight along the top edge, so it reads as an object rather than a hole. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:type="linear"
                android:startColor="#FF2B2F36" android:centerColor="#FF1A1C21" android:endColor="#FF131519" />
        </shape>
    </item>
    <item android:bottom="-1dp" android:left="-1dp" android:right="-1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
